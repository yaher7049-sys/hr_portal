# Copy this file to .env and fill in real values before deploying.
# Locally, you can leave .env missing entirely — sensible defaults are used.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Pick ONE database:
#   SQLite (local testing only, not recommended for production):
# DATABASE_URL=sqlite:///db.sqlite3
#
#   Postgres (Render, Railway, most free-tier hosts give you this URL directly):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
#
#   Your existing MySQL database:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

DJANGO_TIME_ZONE=Asia/Kolkata
